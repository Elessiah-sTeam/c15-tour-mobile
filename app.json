{
  "expo": {
    "name": "C15 Tour ",
    "slug": "c15-tour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.c15tour",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "L'application a besoin du microphone pour enregistrer les messages vocaux du convoi.",
        "NSCameraUsageDescription": "L'application a besoin de la caméra pour scanner le QR code de l'itinéraire.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "L'application a besoin du microphone pour enregistrer les messages vocaux du convoi."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'application a besoin de la caméra pour scanner le QR code de l'itinéraire."
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#7A1E55"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.c15tour"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b0d57a03-43ba-4865-8fd6-c848b4590515"
      }
    },
    "owner": "djocaire"
  }
}
